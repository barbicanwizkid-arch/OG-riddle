# Copy to oracle.env ON THE TABLET. Do not commit or share real credentials.
RIDDLE_OPENAI_KEY='REPLACE_WITH_YOUR_API_KEY'
RIDDLE_OPENAI_BASE='https://api.openai.com/v1'
RIDDLE_OPENAI_MODEL='gpt-4o-mini'
RIDDLE_OPENAI_MAX_TOKENS=1000
# An explicit opt-in enables upstream diary memory. Off means no stored pages
# and no prior-page context; the current handwritten page still goes to your AI provider.
RIDDLE_MEMORY=off
RIDDLE_TZ_OFFSET=-4
